# agent 설정 예시. 운영: C:\ProgramData\WookiDrive\agent.env / 개발: apps/agent/.env

# 공유 루트 (이 폴더 밖은 절대 접근하지 않는다)
DRIVE_ROOT=D:\Drive

# gateway 가 접속할 LAN 리스너
AGENT_HOST=0.0.0.0
AGENT_PORT=7401

# gateway 와 공유하는 요청 서명 키 (32바이트 이상). 생성:
#   node -e "import('@wooki-drive/shared/node').then(m=>console.log(m.generateSecret()))"
# 키 회전 시 "새키,옛키" 처럼 쉼표로 나열 (첫 번째로 서명)
AGENT_HMAC_SECRET=

# (선택) 접속 허용 IP — 방화벽과 별개의 이중 방어. 비우면 검사 안 함.
# 예: 파이 IP
AGENT_ALLOWED_IPS=
