# gateway 설정 예시. 운영: /etc/wooki-drive/gateway.env (권한 600) / 개발: apps/gateway/.env

# 브라우저가 접속하는 주소 (CSRF Origin 검사, OAuth 콜백 기준)
PUBLIC_ORIGIN=https://drive.wooki.cloud

# nginx 뒤 내부 리스너. 외부에 직접 열지 않는다.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=7400

# 데스크탑 agent (LAN). 공유기에서 데스크탑 IP 고정 필요.
AGENT_URL=http://192.168.0.x:7401
# agent 와 같은 값 (32바이트 이상). 키 회전 시 "새키,옛키"
AGENT_HMAC_SECRET=

# 런타임 데이터: buffer/ demo/ cache/ sessions/ guestbook.json
DATA_DIR=/var/lib/wooki-drive
# (선택) 데모 폴더. 기본 DATA_DIR/demo
DEMO_ROOT=

# OAuth 앱 (CLIENT_ID 가 비어 있는 공급자는 비활성)
# Redirect URI: <PUBLIC_ORIGIN>/auth/<kakao|google|github>/callback
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# 오너 화이트리스트: provider:고유ID 를 쉼표로. 이메일 아님.
# 모르면 비워 두고(설정 모드) 한 번 로그인한 뒤 gateway 로그의 "setup mode: signed in via ... sub=" 를 확인
OWNER_ACCOUNTS=

# 로컬 http 개발에서만 false. https 운영에서는 false 불가.
COOKIE_SECURE=true
